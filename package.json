{
  "name": "shark2",
  "private": true,
  "version": "0.1.0",
  "description": "Tooling-only manifest: the repo itself is Python (backend/*.py) + a Vite frontend. No npm dependencies are declared here.",
  "scripts": {
    "audit": "node --experimental-strip-types scripts/independent-rules-check.ts",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:strict": "node scripts/gate.mjs --strict",
    "test:features": "node test/features.mjs"
  },
  "gate": {
    "floor": [
      "test:features",
      "audit",
      "deploy:verify"
    ],
    "debt": {}
  }
}
